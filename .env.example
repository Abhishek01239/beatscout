# ---- BeatScout environment ----
# Copy to .env and adjust.

# Auth
SECRET_KEY=change-me-to-a-long-random-string-32b-min

# Demo data on first boot
SEED_DEMO=1

# Run the job worker inside the API process (no Redis needed)
AUTO_RUN_WORKER=1
WORKER_POLL_SECONDS=2

# API hardening
RATE_LIMIT_ENABLED=1

# Optional: real Spotify discovery (leaves empty -> metadata-only mock provider)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: real YouTube uploads (empty -> mock provider + recorded uploads)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback